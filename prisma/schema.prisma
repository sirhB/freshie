generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          String         @default("owner")
  createdAt     DateTime       @default(now())
  deals         Deal[]
  inquiries     Inquiry[]
  notifications Notification[]
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  niche     String?
  website   String?
  contactEmail String?
  notes     String?
  createdAt DateTime @default(now())
  deals     Deal[]
}

model Deal {
  id              String   @id @default(cuid())
  title           String
  status          String   @default("inquiry") // inquiry, negotiating, active, delivered, paid, archived
  platform        String   // TikTok, Instagram, YouTube, Amazon, Multi
  contentType     String   // How-To, Unboxing, Product Review, Demo, UGC Images
  rateCents       Int      @default(0)
  currency        String   @default("USD")
  dueDate         DateTime?
  usageRightsDays Int?
  briefSummary    String?
  guidelines      String?
  talkingPoints   String?
  productShipped  Boolean  @default(false)
  productReceived Boolean  @default(false)
  trackingNumber  String?
  paymentStatus   String   @default("unpaid") // unpaid, invoiced, paid, overdue
  paidAt          DateTime?
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id])
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id])
  deliverables    Deliverable[]
  checklistItems  ChecklistItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Deliverable {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title       String
  format      String   // video, image, caption, story
  status      String   @default("todo") // todo, filming, editing, review, revisions, delivered, live
  dueDate     DateTime?
  deliveredAt DateTime?
  liveUrl     String?
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  attachments Attachment[]
}

model Attachment {
  id            String       @id @default(cuid())
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  dealId        String?
  fileName      String
  fileUrl       String
  mimeType      String?
  sizeBytes     Int          @default(0)
  kind          String       @default("file") // file, brief, draft, final
  createdAt     DateTime     @default(now())

  @@index([deliverableId])
  @@index([dealId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // deadline, inquiry, payment, product, system
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
}

model Inquiry {
  id               String   @id @default(cuid())
  brandName        String
  contactName      String
  email            String
  budget           String?
  platforms        String?
  message          String
  status           String   @default("new") // new, reviewed, replied, converted, archived
  source           String   @default("web") // web, instagram, demo
  igSenderId       String?
  externalThreadId String?
  autoRepliedAt    DateTime?
  convertedDealId  String?
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  events           InquiryEvent[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([igSenderId])
}

model InquiryEvent {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type      String   // created, status_changed, auto_replied, converted, note
  message   String
  meta      String?  // JSON blob for optional metadata
  createdAt DateTime @default(now())

  @@index([inquiryId])
}

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  category     String
  description  String?
  platform     String
  mediaUrl     String?  // Instagram reel / external permalink
  thumbnailUrl String?
  kind         String   @default("reel") // reel, link, note
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
}


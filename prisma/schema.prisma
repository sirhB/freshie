generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  passwordHash    String
  role            String         @default("owner")
  alertEmail      String?
  alertPhone      String?
  emailAlertsOn   Boolean        @default(true)
  smsAlertsOn     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  deals           Deal[]
  inquiries       Inquiry[]
  notifications   Notification[]
}

model Brand {
  id            String   @id @default(cuid())
  name          String
  niche         String?
  website       String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  notes         String?
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deals         Deal[]
}

model DealTemplate {
  id              String   @id @default(cuid())
  name            String
  platform        String
  contentType     String
  rateCents       Int      @default(10000)
  briefSummary    String?
  guidelines      String?
  talkingPoints   String?
  usageRightsDays Int?     @default(90)
  deliverablesJson String  @default("[]") // [{title,format}]
  checklistJson   String   @default("[]") // [string]
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
}

model Deal {
  id                String   @id @default(cuid())
  title             String
  status            String   @default("inquiry")
  platform          String
  contentType       String
  rateCents         Int      @default(0)
  currency          String   @default("USD")
  dueDate           DateTime?
  publishDate       DateTime? // planned go-live / post date
  usageRightsDays   Int?
  usageRightsEndsAt DateTime?
  briefSummary      String?
  guidelines        String?
  talkingPoints     String?
  productShipped    Boolean  @default(false)
  productReceived   Boolean  @default(false)
  trackingNumber    String?
  paymentStatus     String   @default("unpaid")
  paidAt            DateTime?
  invoiceNumber     String?
  invoiceUrl        String?
  paymentLinkUrl    String?
  brandId           String
  brand             Brand    @relation(fields: [brandId], references: [id])
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  deliverables      Deliverable[]
  checklistItems    ChecklistItem[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Deliverable {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title       String
  format      String
  status      String   @default("todo")
  dueDate     DateTime?
  publishDate DateTime? // when content should go live
  deliveredAt DateTime?
  liveUrl     String?
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  attachments Attachment[]
}

model Attachment {
  id            String       @id @default(cuid())
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  dealId        String?
  inquiryId     String?
  inquiry       Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  mimeType      String?
  sizeBytes     Int          @default(0)
  kind          String       @default("file")
  createdAt     DateTime     @default(now())

  @@index([deliverableId])
  @@index([dealId])
  @@index([inquiryId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  emailedAt DateTime?
  smsSentAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
}

model Inquiry {
  id               String   @id @default(cuid())
  brandName        String
  contactName      String
  email            String
  budget           String?
  platforms        String?
  message          String
  status           String   @default("new")
  source           String   @default("web")
  igSenderId       String?
  externalThreadId String?
  autoRepliedAt    DateTime?
  convertedDealId  String?
  leadScore        Int      @default(0) // 0-100
  leadTier         String   @default("maybe") // hot, maybe, pass
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  events           InquiryEvent[]
  messages         InquiryMessage[]
  attachments      Attachment[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([igSenderId])
  @@index([leadTier])
}

model InquiryEvent {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type      String
  message   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([inquiryId])
}

model InquiryMessage {
  id         String   @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  direction  String   // inbound, outbound
  body       String
  mediaUrl   String?
  mediaType  String?
  externalId String?
  createdAt  DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  slug         String?  @unique
  category     String
  description  String?
  platform     String
  mediaUrl     String?
  thumbnailUrl String?
  kind         String   @default("reel") // reel, link, note, case_study
  caseBody     String?  // markdown/plain case study story
  resultsNote  String?
  brandName    String?
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
}


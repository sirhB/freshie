# Vercel storage prefix is DB_ → connection string is DB_URL
DB_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional aliases (auto-mapped when DB_URL is unset):
# DB_POSTGRES_PRISMA_URL / DB_POSTGRES_URL / DATABASE_URL

AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="https://kaylathecreateher.vercel.app"

# Instagram Messaging API (official Meta webhook)
INSTAGRAM_VERIFY_TOKEN="kayla-createher-verify"
INSTAGRAM_APP_SECRET=""
INSTAGRAM_PAGE_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_AUTO_REPLY="true"

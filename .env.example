# Vercel storage prefix is DB_ → connection string is DB_URL
DB_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional aliases (auto-mapped when DB_URL is unset):
# DB_POSTGRES_PRISMA_URL / DB_POSTGRES_URL / DATABASE_URL

# Required in production (no insecure fallback)
AUTH_SECRET="replace-with-a-long-random-string"
# Must match the public site origin (custom domain or *.vercel.app)
NEXTAUTH_URL="https://kaylathecreateher.vercel.app"

# Durable uploads (Vercel Blob) — required on Vercel for Site CMS + deal files
BLOB_READ_WRITE_TOKEN=""

# Instagram Messaging API (official Meta webhook)
INSTAGRAM_VERIFY_TOKEN="kayla-createher-verify"
INSTAGRAM_APP_SECRET=""
INSTAGRAM_PAGE_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_AUTO_REPLY="true"

# Seed (local only). Production: seed once on empty DB, then change password in Settings.
# SEED_RESET="true"
# SEED_OWNER_PASSWORD="temporary-password-change-after-login"
